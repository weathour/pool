</footer>

<script>
const POOL = {payload};

const esc = s => String(s ?? '').replace(/[&<>"]/g, c => ({{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}}[c]));

function field(k, v) {{
  if (!v) return '';
  return `<div class="field"><span class="k">${{esc(k)}}：</span>${{esc(v)}}</div>`;
}}

// ---- 公告板
(function () {{
  const el = document.getElementById('requests');
  const order = {{open:0, claimed:1, delivered:2, accepted:3, closed:8, withdrawn:9}};
  const rs = [...POOL.requests].sort((a,b) => (order[a.status]??5) - (order[b.status]??5));
  if (!rs.length) {{ el.innerHTML = '<p class="empty">还没有单子。开第一张吧。</p>'; return; }}
  el.innerHTML = rs.map(r => `
    <div class="card">
      <h3>${{esc(r.title)}} <span class="tag">${{esc(r.kind)}}</span>
        <span class="tag s-${{esc(r.status)}}">${{esc(r.status)}}</span></h3>
      ${{field('要什么', r.spec)}}
      ${{field('怎么算做完了', r.acceptance)}}
      <div class="meta"><span>${{esc(r.id)}}</span><span>由 ${{esc(r.by)}}</span>
        <span>${{esc(r.at)}}</span></div>
    </div>`).join('');
}})();

// ---- 交付物
(function () {{
  const el = document.getElementById('deliverables');
  if (!POOL.deliverables.length) {{
    el.innerHTML = '<p class="empty">还没有交付物。</p>'; return;
  }}
  el.innerHTML = POOL.deliverables.map(d => `
    <div class="card">
      <h3>${{esc(d.id)}} <span class="tag">${{esc(d.kind)}}</span>
        ${{d.result ? `<span class="tag ${{d.result}}">${{d.result}}</span>`
                    : '<span class="tag">等复核</span>'}}</h3>
      <div class="meta">
        <span>交付 ${{esc(d.deliverer)}}</span>
        ${{d.reviewer ? `<span>复核 ${{esc(d.reviewer)}}</span>` : ''}}
        ${{d.credit !== null ? `<span>估值 ${{d.credit}} credit</span>` : ''}}
        <span>被引用 ${{d.reuse}} 次</span>
        <span>对应 ${{esc(d.request_id)}}</span>
      </div>
      ${{field('复核理由', d.reason)}}
    </div>`).join('');
}})();

// ---- credit
(function () {{
  const el = document.getElementById('credits');
  const bal = Object.entries(POOL.balances).sort((a,b) => b[1]-a[1]);
  let html = '';
  if (bal.length) {{
    html += '<table><tr><th>身份</th><th>credit</th></tr>' +
      bal.map(([k,v]) => `<tr><td>${{esc(k)}}</td><td>${{v.toFixed(1)}}</td></tr>`).join('') +
      '</table>';
  }} else {{
    html += '<p class="empty">还没有入账。credit 在交付物通过复核并被确认之后才产生。</p>';
  }}
  if (POOL.endorsements.length) {{
    html += '<h2 style="font-size:1rem">谁为谁背书过</h2>';
    html += '<table><tr><th>复核者</th><th>为谁背书</th><th>交付物</th></tr>' +
      POOL.endorsements.map(e =>
        `<tr><td>${{esc(e.reviewer)}}</td><td>${{esc(e.deliverer)}}</td><td>${{esc(e.id)}}</td></tr>`
      ).join('') + '</table>';
    html += '<p class="sub" style="margin-top:.8rem">credit 不是一个分数，是一份由三个人联署的认可记录：' +
            '交付的人、复核的人、用的人，各签一句。所以「谁为谁背书」比「谁分高」更值得看。</p>';
  }}
  el.innerHTML = html;
}})();
</script>
</body>
</html>
"""


def render(view: dict) -> str:
    # ★ 先转义再拼 <br>：反过来会把 <br> 自己转义掉，页面上显示成
    #   一行里的 "&lt;br&gt;"（踩过）。
    heads = "<br>".join(
        html.escape(f"{name}: {h}" if h else f"{name}: （空）")
        for name, h in view["chain_heads"].items()
    )
    return PAGE.format(
        n_open=view["counts"]["open"],
        n_delivered=view["counts"]["delivered"],
        n_accepted=view["counts"]["accepted"],
        n_reused=view["counts"]["reused"],
        n_members=len(view["members"]),
        heads=heads,
        payload=json.dumps(view, ensure_ascii=False, sort_keys=True),
    )


def main() -> int:
    ap = argparse.ArgumentParser(description="生成展示站")
    ap.add_argument("--out", default=str(ROOT / "site"))
    args = ap.parse_args()

    data = load()
    view = build_view(data)
    page = render(view)

    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    (out / "index.html").write_text(page, encoding="utf-8")

    # Cloudflare Pages 用得到
    (out / "_headers").write_text(
        "/*\n  X-Content-Type-Options: nosniff\n  Referrer-Policy: no-referrer\n",
        encoding="utf-8",
    )

    size = (out / "index.html").stat().st_size
    c = view["counts"]
    print(f"✓ 已生成 {out/'index.html'}（{size/1024:.1f} KB）")
    print(
        f"  单 {c['open']} 开着 / {c['delivered']} 等复核 / {c['accepted']} 成案"
        f" · 交付物 {c['deliverables']} 件（{c['reused']} 件被引用）"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
