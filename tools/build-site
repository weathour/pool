#!/usr/bin/env python3
"""生成公开展示站 —— 输出到 site/。

设计原则：**单文件、零依赖、纯静态。**
  - 没有 CDN、没有框架、没有网络请求 —— 页面自己就是完整的
  - 数据内嵌在页面里，所以打开就能看，不需要任何后端
  - 任何人都能把这个 HTML 存下来，它仍然是完整的

它展示：
  1. 公告板（开着的单、在等的复核）
  2. 最近的交付物
  3. credit 榜（含"谁为谁背书"的关系）
  4. 验证方式（让别人能自己核对整份账）

用法：
    python3 tools/build-site            # 生成 site/
    python3 tools/build-site --out X    # 输出到 X
"""

from __future__ import annotations

import argparse
import html
import json
import sys
from collections import defaultdict
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import pool  # noqa: E402

# ---------------------------------------------------------------- 数据整理


def load() -> dict:
    data = {}
    for name in pool.DATA_FILES:
        data[name] = pool.read_jsonl(ROOT / "data" / f"{name}.jsonl")
    return data


def build_view(data: dict) -> dict:
    keyring = data["keyring"]
    handle_of = {}
    for rec in keyring:
        if rec.get("pubkey"):
            handle_of[rec["pubkey"]] = rec.get("handle") or rec["pubkey"][-8:]

    def h(pub: str | None) -> str:
        if not pub:
            return "—"
        return handle_of.get(pub, pub[-8:] + "…")

    # ---- 申请单
    req_status = pool.request_status(data["requests"])
    req_latest = pool.project(data["requests"])
    requests = []
    for rid, rec in sorted(req_latest.items()):
        requests.append(
            {
                "id": rid,
                "title": rec.get("title", ""),
                "type": rec.get("type", ""),
                "kind": rec.get("artifact_kind", ""),
                "spec": rec.get("spec", ""),
                "acceptance": rec.get("acceptance", ""),
                "links": rec.get("links", []),
                "status": req_status.get(rid, "?"),
                "by": h(rec.get("by")),
                "at": rec.get("at", "")[:10],
            }
        )

    # ---- 交付物
    deliv_latest = pool.project(data["deliverables"])
    # 只保留真正被 create 过的（project 出来的每条都有 last_op）
    creates = {
        k: v
        for k, v in deliv_latest.items()
        if v.get("request_id") and v.get("deliverer")
    }
    reuse_map = pool.derive_reuse(data["deliverables"])
    deliverables = []
    for did, rec in sorted(creates.items()):
        review = rec.get("review") or {}
        base = review.get("reproduce_minutes") or rec.get("reproduce_minutes")
        deliverables.append(
            {
                "id": did,
                "request_id": rec.get("request_id", ""),
                "kind": rec.get("artifact_kind", ""),
                "deliverer": h(rec.get("deliverer")),
                "reviewer": h(review.get("by")) if review else None,
                "result": review.get("result") if review else None,
                "reason": review.get("reason") if review else None,
                "minutes": base,
                "credit": round(base / 10, 1) if isinstance(base, (int, float)) else None,
                "reuse": reuse_map.get(did, 0),  # ★ 由 links 推导，不看自报
                "at": rec.get("at", "")[:10],
            }
        )

    # ---- 账本与背书关系
    credits = data["credits"]
    balances: dict[str, float] = defaultdict(float)
    for c in credits:
        # ★ reuse 是【真 credit】，必须计入：mint 只发定基，产物被引用后
        #   由 `sign reuse` 补发加成，两笔加在一起才是账。漏掉 reuse 会让
        #   公开页显示的数比 tools/status 和账本本身都小（踩过：8.5 vs 9.4）。
        if c.get("op") in ("mint", "reuse", "decay", "adjust") and isinstance(c.get("amount"), (int, float)):
            balances[h(c.get("member"))] += c["amount"]

    endorsements = [
        {"reviewer": d["reviewer"], "deliverer": d["deliverer"], "id": d["id"]}
        for d in deliverables
        if d["reviewer"] and d["result"] == "pass"
    ]

    return {
        "handles": sorted(set(handle_of.values())),
        "members": sorted(handle_of.values()),
        "requests": requests,
        "deliverables": deliverables,
        "balances": dict(balances),
        "endorsements": endorsements,
        "chain_heads": {
            name: (data[name][-1]["hash"] if data[name] else None)
            for name in pool.DATA_FILES
        },
        "counts": {
            "open": sum(1 for r in requests if r["status"] == "open"),
            "claimed": sum(1 for r in requests if r["status"] == "claimed"),
            "delivered": sum(1 for r in requests if r["status"] == "delivered"),
            "accepted": sum(1 for r in requests if r["status"] == "accepted"),
            "deliverables": len(deliverables),
            "reused": sum(1 for d in deliverables if d["reuse"] > 0),
        },
    }


# ---------------------------------------------------------------- 渲染

