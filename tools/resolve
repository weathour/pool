#!/usr/bin/env python3
"""合并冲突解决器 —— git merge 之后跑它。

背景：
  两个人同时从同一个状态往下追加记录，git 会在**同一位置**插入，
  于是产生冲突。这不是异常，是正常情况。

  但冲突标记（<<<<<<< ======= >>>>>>>）不是合法 JSONL，
  必须先把它们去掉，再重排、重链。

它做的事：
  1. 去掉冲突标记，两边的内容都保留（**没有任何记录会被丢掉**）
  2. 丢掉"已经在公共祖先里出现过"的重复行（按 hash 去重）
  3. 按 at 时间排序
  4. 重算 seq 与 prev（内容不动，所以 hash 与签名仍然有效）
  5. 重复 id 会报出来 —— 那种情况要人来判断

用法：
    python3 tools/resolve              # 检查，只报告
    python3 tools/resolve --write      # 修复并重跑校验
"""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "lib"))

import pool  # noqa: E402

MARKERS = ("<<<<<<<", "=======", ">>>>>>>", "|||||||")


def strip_conflicts(text: str) -> tuple[list[dict], list[str]]:
    """去掉冲突标记，返回 (记录列表, 冲突块数量)。两边内容都保留。"""
    records: list[dict] = []
    conflicts = 0
    in_conflict = False
    for raw in text.splitlines():
        line = raw.rstrip("\n")
        if line.startswith("<<<<<<<") or line.startswith("|||||||"):
            in_conflict = True
            conflicts += 1
            continue
        if line.startswith("=======") and in_conflict:
            continue
        if line.startswith(">>>>>>>"):
            in_conflict = False
            continue
        if not line.strip():
            continue
        try:
            records.append(json.loads(line))
        except json.JSONDecodeError as exc:
            print(f"  ⚠ 跳过一行非法 JSON：{line[:60]}…（{exc.msg}）")
    return records, conflicts


def dedupe(records: list[dict]) -> tuple[list[dict], int]:
    """按 hash 去重 —— 两边共同祖先里的记录会在冲突块两侧各出现一次。"""
    seen: set[str] = set()
    out: list[dict] = []
    dropped = 0
    for rec in records:
        h = rec.get("hash")
        if h and h in seen:
            dropped += 1
            continue
        if h:
            seen.add(h)
        out.append(rec)
    return out, dropped


def sort_key(rec: dict):
    # 按业务时间排序；同一时刻用 id 做稳定的次序
    return (rec.get("at") or "", rec.get("by") or "", rec.get("id") or "", rec.get("hash") or "")


def rechain(records: list[dict]) -> list[dict]:
    """重算 seq 与 prev。内容不动 —— 所以 hash 和签名都还成立。"""
    out: list[dict] = []
    for idx, rec in enumerate(records, 1):
        rec = dict(rec)
        rec["seq"] = idx
        rec["prev"] = out[-1]["hash"] if out else None
        out.append(rec)
    return out


def check_dup_ids(records: list[dict]) -> list[str]:
    """同一个 id 出现超过一次的【不同记录】，需要人来判断。"""
    by_id: dict[str, set[str]] = {}
    for rec in records:
        rid = rec.get("id")
        if isinstance(rid, str):
            by_id.setdefault(rid, set()).add(rec.get("hash") or "")
    # 同一实体的多次操作（open/claim/close）是正常的，不算重复；
    # 真正可疑的是同一个 id 有多条【同 op】的记录。
    ops: dict[tuple[str, str], int] = {}
    for rec in records:
        rid, op = rec.get("id"), rec.get("op")
        if isinstance(rid, str) and isinstance(op, str):
            ops[(rid, op)] = ops.get((rid, op), 0) + 1
    return [f"{rid} 的 {op} 有 {n} 条" for (rid, op), n in ops.items() if n > 1]


def main() -> int:
    ap = argparse.ArgumentParser(description="合并冲突解决器")
    ap.add_argument("--write", action="store_true", help="实际写回")
    args = ap.parse_args()

    dirty: list[str] = []
    total_conflicts = 0

    for name in pool.DATA_FILES:
        path = ROOT / "data" / f"{name}.jsonl"
        if not path.exists():
            continue
        text = path.read_text(encoding="utf-8")
        if not any(m in text for m in MARKERS):
            continue

        dirty.append(name)
        records, conflicts = strip_conflicts(text)
        total_conflicts += conflicts

        before = len(records)
        records, dropped = dedupe(records)
        records.sort(key=sort_key)
        records = rechain(records)

        dups = check_dup_ids(records)

        print(f"\n{name}.jsonl")
        print(f"  冲突块 {conflicts} 个，读回 {before} 条，按 hash 去重丢掉 {dropped} 条")
        print(f"  → 保留 {len(records)} 条，已重排时间并重链")
        if dups:
            print("  ⚠ 需要人判断的重复：")
            for d in dups:
                print(f"      {d}")

        if args.write:
            pool.write_jsonl(path, records)
            print("  已写回")

    if not dirty:
        print("✓ 没有发现冲突标记，不需要解决")
        return 0

    if not args.write:
        print(f"\n共 {len(dirty)} 个文件有冲突标记。加 --write 解决。")
        return 1

    print(f"\n✓ 已解决 {len(dirty)} 个文件。下面重跑校验：")
    import subprocess

    return subprocess.call([sys.executable, str(ROOT / "tools" / "validate")])


if __name__ == "__main__":
    sys.exit(main())
