#!/bin/sh
# 推送到 Gitea 之后，自动把同一个提交镜像到 GitHub。
#
# 为什么不用 Gitea 自带的"推送镜像"功能或 post-receive.d 钩子：
#   两者在这台机器上都实测不生效（定时任务没有调度；.d 钩子没被触发）。
#   本地 post-push 钩子是最可靠的一环 —— 推送这个动作一定发生在本机。
#
# 失败不阻塞（退出码永远是 0）：镜像挂了不该让主仓库的推送失败。
set -u

REMOTE_NAME="github"
CRED="$HOME/.pool/github-credentials"

# 只在推送到 origin（Gitea）时触发
remote="${1:-}"
url="${2:-}"
case "$url" in
    *github.com*) exit 0 ;;   # 推给 GitHub 的那次不再递归
esac

[ "$remote" = "origin" ] || exit 0
[ -f "$CRED" ] || { echo "  [mirror] 没有 $CRED，跳过镜像" >&2; exit 0; }

LOG="$HOME/.pool/github-mirror.log"
{
    echo "--- $(date '+%F %T') 镜像到 GitHub ---"
    GIT_TERMINAL_PROMPT=0 \
    git -c "credential.helper=store --file=$CRED" \
        push --quiet --prune github \
        '+refs/heads/*:refs/heads/*' '+refs/tags/*:refs/tags/*' 2>&1
    echo "--- 退出码 $? ---"
} >> "$LOG" 2>&1

exit 0
